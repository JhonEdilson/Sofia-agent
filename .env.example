# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# ElevenLabs: agente de voz/texto. /api/token pide una conversación firmada con esta llave.
ELEVENLABS_API_KEY=
AGENT_ID=

# Cliente OAuth de Google Cloud (el mismo para Gmail y Calendar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Aviso a recepción (/api/avisar-humano): refresh token con scope gmail.send.
GMAIL_REFRESH_TOKEN=
AVISO_TO=
# Secreto compartido con el webhook tool `avisar_humano` de ElevenLabs (header x-avisar-secret).
AVISAR_SECRET=

# Agenda del formulario (/api/agendar, /api/disponibilidad): refresh token con scope `calendar`
# (freeBusy no funciona con calendar.events). Puede ser el mismo token que GMAIL_REFRESH_TOKEN si se
# emitió con los dos scopes. GOOGLE_CALENDAR_ID debe ser el calendario que usa el agente de voz.
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# WhatsApp de Jhon para el botón "¿La quiere para su clínica?": solo dígitos con indicativo, sin +.
# Va en variable de entorno porque el repo es público. Sin ella el botón no se muestra.
JHON_WHATSAPP=
